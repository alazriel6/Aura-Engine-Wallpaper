<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="AccentColor">#7DD3FC</Color>
    <Color x:Key="BorderGlowColor">#A78BFA</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7FF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA8C4" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B00B1020" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#65182236" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#88A78BFA" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#B0060918" />
</ResourceDictionary>
