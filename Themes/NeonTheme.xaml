<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Color x:Key="AccentColor">#00F0FF</Color>
    <Color x:Key="BorderGlowColor">#FFE100</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#050505" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B0111111" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#801A1A1A" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#99262626" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#E5020202" />
    <SolidColorBrush x:Key="InputBrush" Color="#800D0D0D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#55FFE100" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#AA00F0FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#44FFE100" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E5000000" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#DF050505" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#050505" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="#000000" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#002B33" Offset="0" />
        <GradientStop Color="#000000" Offset="0.5" />
        <GradientStop Color="#332D00" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
