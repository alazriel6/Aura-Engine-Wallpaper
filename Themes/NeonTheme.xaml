<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#23F09A</Color>
    <Color x:Key="BorderGlowColor">#23F09A</Color>
    <Color x:Key="ShadowColor">#020706</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#03130D" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#050B0A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0FFF9" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94BAAA" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B00B1815" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#6520362E" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#7431534A" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#A0081110" />
    <SolidColorBrush x:Key="InputBrush" Color="#7A071210" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B52615A" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#9923F09A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5523F09A" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#79060C0B" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#D006100F" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#B004120C" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16352E" Offset="0" />
        <GradientStop Color="#111D2B" Offset="0.52" />
        <GradientStop Color="#40233A" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="PreviewGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,42,42"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="#4623F09A" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="42,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,42" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
