<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#33F5FF</Color>
    <Color x:Key="BorderGlowColor">#33F5FF</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#071116" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0D12" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F8FB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA8B8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B0141822" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#651B2230" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#70324255" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#9C0E121A" />
    <SolidColorBrush x:Key="InputBrush" Color="#7A0D121B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#38485964" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#8833F5FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5533F5FF" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#7A090D13" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#D00B1017" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#B0070B10" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#202B3A" Offset="0" />
        <GradientStop Color="#112431" Offset="0.42" />
        <GradientStop Color="#2B1F39" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="PreviewGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,42,42"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="#3C33F5FF" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="42,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,42" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
