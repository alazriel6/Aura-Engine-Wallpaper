<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="AccentColor">#E0F2FE</Color>
    <Color x:Key="BorderGlowColor">#93C5FD</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#071116" />
    <SolidColorBrush x:Key="PanelBrush" Color="#66141A24" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#44212B38" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#66101822" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#A0070B10" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#8093C5FD" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#8A070B10" />
</ResourceDictionary>
