<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Color x:Key="AccentColor">#88FFFFFF</Color>
    <Color x:Key="BorderGlowColor">#A0FFFFFF</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#10000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="PanelBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#25FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="InputBrush" Color="#15000000" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#2A000000" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#55050505" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#44000000" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#80000000" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="#66000000" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
