<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="BorderGlowColor">#D500F9</Color>
    <Color x:Key="ShadowColor">#1A002A</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0D001A" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0914" />
    <SolidColorBrush x:Key="TextBrush" Color="#E0F7FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7A93B2" />
    <SolidColorBrush x:Key="PanelBrush" Color="#90141026" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#701C1636" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#992C1D54" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#A5090612" />
    <SolidColorBrush x:Key="InputBrush" Color="#88100C1F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#6600E5FF" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#AA00E5FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#55D500F9" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#8807050F" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#CC090712" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#CC04030A" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#0B0914" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="#0B0914" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D0E30" Offset="0" />
        <GradientStop Color="#004D66" Offset="0.5" />
        <GradientStop Color="#4A0054" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
