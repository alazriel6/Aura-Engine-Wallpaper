<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Color x:Key="AccentColor">#B570FF</Color>
    <Color x:Key="BorderGlowColor">#B570FF</Color>
    <Color x:Key="ShadowColor">#0A0012</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0E0017" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#150C1C" />
    <SolidColorBrush x:Key="TextBrush" Color="#EFE6F5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9F8AA8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D0201229" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#992C1A38" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#BB3E254F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#E50D0612" />
    <SolidColorBrush x:Key="InputBrush" Color="#99160B1F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#55513A63" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#77B570FF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#44B570FF" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E50A050F" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#DF150C1C" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#B009040D" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#150C1C" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="#0E0714" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C1A38" Offset="0" />
        <GradientStop Color="#1A0D24" Offset="0.5" />
        <GradientStop Color="#402354" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
