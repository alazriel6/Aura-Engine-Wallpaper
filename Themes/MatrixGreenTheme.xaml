<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Color x:Key="AccentColor">#00FF41</Color>
    <Color x:Key="BorderGlowColor">#008F11</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#020803" />
    <SolidColorBrush x:Key="TextBrush" Color="#00FF41" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#008F11" />
    <SolidColorBrush x:Key="PanelBrush" Color="#B0051107" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#88081A0B" />
    <SolidColorBrush x:Key="HoverPanelBrush" Color="#990B2610" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#CC020A04" />
    <SolidColorBrush x:Key="InputBrush" Color="#A0041206" />
    <SolidColorBrush x:Key="BorderBrush" Color="#55008F11" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#9900FF41" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3300FF41" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E5010502" />
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#DF020803" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#DD000000" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#020803" />
    <SolidColorBrush x:Key="WindowTitleBrush" Color="#010502" />

    <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#001F06" Offset="0" />
        <GradientStop Color="#003D0C" Offset="0.5" />
        <GradientStop Color="#000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
