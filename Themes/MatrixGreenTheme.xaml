<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="AccentColor">#65FF7A</Color>
    <Color x:Key="BorderGlowColor">#65FF7A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#021006" />
    <SolidColorBrush x:Key="TextBrush" Color="#EFFFF0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8DC99A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#AC07130A" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#6415281A" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="#9965FF7A" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#B0021006" />
</ResourceDictionary>
