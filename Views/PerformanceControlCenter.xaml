<UserControl x:Class="LiveWallpaperApp.Views.PerformanceControlCenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LiveWallpaperApp.Views"
             xmlns:models="clr-namespace:LiveWallpaperApp.Models"
             xmlns:helpers="clr-namespace:LiveWallpaperApp.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1000">
    <UserControl.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <helpers:NotEqualConverter x:Key="NotEqualConverter" />
    </UserControl.Resources>
    <ScrollViewer Style="{DynamicResource PageContainerStyle}">
        <StackPanel Margin="0,0,16,16">
            
            <TextBlock Text="Performance Control Center" Style="{DynamicResource TitleTextStyle}" FontSize="24" Margin="0,0,0,4" />
            <TextBlock Text="Complete control over hardware usage and system impact." Style="{DynamicResource CaptionStyle}" Margin="0,0,0,24" />

            <!-- ROW 0: PERFORMANCE SCORE -->
            <Border Style="{DynamicResource PanelStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Width="100" Height="100" CornerRadius="50" Background="{DynamicResource SoftPanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3">
                        <TextBlock Text="{Binding PerformanceGrade}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Performance Score" Style="{DynamicResource TitleTextStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="System Capability" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SystemCapabilityScore}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Wallpaper Impact" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding CurrentWallpaperImpact}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Est. Power Usage" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding EstimatedPowerUsage}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Processor (CPU)" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SystemCpuName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Graphics (GPU)" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SystemGpuName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="System Memory" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SystemTotalRam}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        
                        <Border Background="#1AFFFFFF" Padding="12" CornerRadius="6" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16" />
                                <TextBlock Text="{Binding PerformanceRecommendation}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1 -->
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- PERFORMANCE PROFILES -->
                <Border Grid.Column="0" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Performance Profiles" Style="{DynamicResource TitleTextStyle}" />
                        <TextBlock Text="Choose a preset to automatically configure settings." Style="{DynamicResource CaptionStyle}" Margin="0,0,0,12" />
                        
                        <RadioButton GroupName="PerfProfile" Content="Ultra (120 FPS+, Full Quality)" IsChecked="{Binding Settings.PowerProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PowerProfileMode.UltraPerformance}}" Margin="0,0,0,8" />
                        <RadioButton GroupName="PerfProfile" Content="Balanced (60 FPS, Standard)" IsChecked="{Binding Settings.PowerProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PowerProfileMode.Balanced}}" Margin="0,0,0,8" />
                        <RadioButton GroupName="PerfProfile" Content="Battery Saver (30 FPS, Reduced Quality)" IsChecked="{Binding Settings.PowerProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PowerProfileMode.BatterySaver}}" Margin="0,0,0,8" />
                        <RadioButton GroupName="PerfProfile" Content="Minimal (15 FPS, Pauses frequently)" IsChecked="{Binding Settings.PowerProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:PowerProfileMode.MinimalResource}}" />
                        
                        <TextBlock Text="Estimated Impact: Medium" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- SMART PAUSE ENGINE -->
                <Border Grid.Column="2" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Smart Pause Engine" Style="{DynamicResource TitleTextStyle}" />
                        <TextBlock Text="Automatically pause wallpaper to free up resources." Style="{DynamicResource CaptionStyle}" Margin="0,0,0,12" />
                        
                        <CheckBox Content="Game is running (Fullscreen)" IsChecked="{Binding Settings.PauseFullscreenGame}" />
                        <CheckBox Content="Fullscreen application is active" IsChecked="{Binding Settings.PauseMaximizedApplication}" />
                        <CheckBox Content="Laptop is on battery" IsChecked="{Binding Settings.PauseOnBattery}" />
                        <CheckBox Content="Monitor is sleeping" IsChecked="{Binding Settings.PauseMonitorSleeping}" />
                        <CheckBox Content="Screen is locked" IsChecked="{Binding Settings.PauseScreenLocked}" />
                        <CheckBox Content="Remote Desktop session" IsChecked="{Binding Settings.PauseRemoteDesktop}" />
                        <CheckBox Content="Screen sharing active" IsChecked="{Binding Settings.PauseScreenSharing}" />
                        <CheckBox Content="Streaming software detected" IsChecked="{Binding Settings.PauseStreamingSoftware}" />
                        <CheckBox Content="High CPU load" IsChecked="{Binding Settings.PauseHighCpuTemperature}" />
                        <CheckBox Content="High GPU load" IsChecked="{Binding Settings.PauseHighGpuUsage}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 2 -->
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- FPS CONTROL CENTER -->
                <Border Grid.Column="0" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FPS Control Center" Style="{DynamicResource TitleTextStyle}" />
                        
                        <TextBlock Text="Target FPS" Style="{DynamicResource CaptionStyle}" Margin="0,8,0,8" />
                        <ComboBox ItemsSource="{Binding FpsModes}" SelectedItem="{Binding Settings.FpsLimit}" />
                        
                        <CheckBox Content="Frame Limiter" IsChecked="{Binding Settings.FrameLimiterEnabled}" Margin="0,12,0,0" />
                        <CheckBox Content="V-Sync" IsChecked="{Binding Settings.VSyncEnabled}" />
                        <CheckBox Content="Dynamic FPS (Lower when inactive)" IsChecked="{Binding Settings.DynamicFpsEnabled}" />
                        
                        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource SoftPanelBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current" Style="{DynamicResource CaptionStyle}" />
                                    <TextBlock Text="{Binding LiveFps}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Average" Style="{DynamicResource CaptionStyle}" />
                                    <TextBlock Text="{Binding SessionStats.AverageFps, StringFormat={}{0:0.0}}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max" Style="{DynamicResource CaptionStyle}" />
                                    <TextBlock Text="{Binding EffectiveFps}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- RENDERING ENGINE -->
                <Border Grid.Column="2" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Rendering Engine" Style="{DynamicResource TitleTextStyle}" />
                        
                        <TextBlock Text="Rendering Backend" Style="{DynamicResource CaptionStyle}" Margin="0,8,0,8" />
                        <ComboBox ItemsSource="{Binding RenderEngines}" SelectedItem="{Binding Settings.RenderEngine}" />
                        
                        <TextBlock Text="Advanced Options" Style="{DynamicResource CaptionStyle}" Margin="0,16,0,8" />
                        <CheckBox Content="Hardware Acceleration" IsChecked="{Binding Settings.HardwareAcceleration, Converter={StaticResource NotEqualConverter}, ConverterParameter={x:Static models:HardwareAccelerationMode.Disabled}}" />
                        <CheckBox Content="Hardware Video Decoding" IsChecked="{Binding Settings.HardwareVideoDecoding}" />
                        <CheckBox Content="Multi-thread Rendering" IsChecked="{Binding Settings.MultiThreadRendering}" />
                        <CheckBox Content="Hardware Scaling" IsChecked="{Binding Settings.HardwareScaling}" />
                        <CheckBox Content="GPU Scheduling" IsChecked="{Binding Settings.GpuScheduling}" />
                        
                        <TextBlock Text="Compatibility: Fully Supported" Foreground="#33FF99" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 3 -->
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- ADAPTIVE PERFORMANCE -->
                <Border Grid.Column="0" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Adaptive Performance" Style="{DynamicResource TitleTextStyle}" />
                        <TextBlock Text="Automatically optimize performance based on system load." Style="{DynamicResource CaptionStyle}" Margin="0,0,0,12" />
                        
                        <CheckBox Content="Reduce FPS when CPU &gt; 80%" IsChecked="{Binding Settings.ReduceFpsHighCpu}" />
                        <CheckBox Content="Reduce FPS when GPU &gt; 80%" IsChecked="{Binding Settings.ReduceFpsHighGpu}" />
                        <CheckBox Content="Reduce quality when RAM &gt; 85%" IsChecked="{Binding Settings.ReduceQualityHighRam}" />
                        <CheckBox Content="Disable effects on battery" IsChecked="{Binding Settings.DisableEffectsOnBattery}" />
                        <CheckBox Content="Auto switch performance profile" IsChecked="{Binding Settings.AutoSwitchPerformanceProfile}" />
                        
                        <TextBlock Text="Status: Active and Monitoring" Foreground="#33FF99" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- BACKGROUND BEHAVIOR -->
                <Border Grid.Column="2" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Background Behavior" Style="{DynamicResource TitleTextStyle}" />
                        
                        <CheckBox Content="Reduce FPS when unfocused" IsChecked="{Binding Settings.ReduceFpsUnfocused}" />
                        <CheckBox Content="Pause when minimized" IsChecked="{Binding Settings.PauseMinimized}" />
                        <CheckBox Content="Pause when monitor off" IsChecked="{Binding Settings.PauseMonitorOff}" />
                        <CheckBox Content="Reduce update frequency" IsChecked="{Binding Settings.ReduceUpdateFrequency}" />
                        <CheckBox Content="Suspend background rendering" IsChecked="{Binding Settings.SuspendBackgroundRendering}" />
                        
                        <TextBlock Text="Est. Power Savings: ~45%" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 4: LIVE RESOURCE MONITOR -->
            <Border Style="{DynamicResource PanelStyle}" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Live Resource Monitor" Style="{DynamicResource TitleTextStyle}" />
                    
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- CPU Chart -->
                        <Border Grid.Column="0" Background="{DynamicResource SoftPanelBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="CPU Usage" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveCpuUsage}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Border Height="60" Background="#0AFFFFFF" CornerRadius="4" ClipToBounds="True">
                                    <Polyline Points="{Binding CpuGraphPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Fill" VerticalAlignment="Bottom" />
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- GPU Chart -->
                        <Border Grid.Column="2" Background="{DynamicResource SoftPanelBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="GPU Usage" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveGpuUsage}" Foreground="#FF3366" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Border Height="60" Background="#0AFFFFFF" CornerRadius="4" ClipToBounds="True">
                                    <Polyline Points="{Binding GpuGraphPoints}" Stroke="#FF3366" StrokeThickness="2" Stretch="Fill" VerticalAlignment="Bottom" />
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- RAM Chart -->
                        <Border Grid.Column="4" Background="{DynamicResource SoftPanelBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="RAM Usage" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveRamUsage}" Foreground="#33FF99" HorizontalAlignment="Right" FontWeight="Bold" />
                                </Grid>
                                <Border Height="60" Background="#0AFFFFFF" CornerRadius="4" ClipToBounds="True">
                                    <Polyline Points="{Binding RamGraphPoints}" Stroke="#33FF99" StrokeThickness="2" Stretch="Fill" VerticalAlignment="Bottom" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ROW 5 -->
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- SESSION ANALYTICS -->
                <Border Grid.Column="0" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Session Analytics" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,12" />
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Session Runtime" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding LiveRunningTime}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Total Runtime Today" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.TotalRuntimeToday, StringFormat=hh\\:mm\\:ss}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Peak GPU Usage" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.PeakGpuUsage, StringFormat={}{0:0.0}%}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="Peak RAM Usage" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.PeakRamUsageMb, StringFormat={}{0:0.0} MB}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Dropped Frames" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.DroppedFrames}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock Text="Rendered Frames" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.RenderedFrames}" FontWeight="SemiBold" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="6" Grid.Column="0">
                                <TextBlock Text="Wallpapers Applied" Style="{DynamicResource CaptionStyle}" />
                                <TextBlock Text="{Binding SessionStats.TotalWallpapersApplied}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RESOURCE LIMITS -->
                <Border Grid.Column="2" Style="{DynamicResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Resource Limits" Style="{DynamicResource TitleTextStyle}" />
                        
                        <TextBlock Text="{Binding Settings.MaxCpuUsageLimit, StringFormat=Max CPU Usage: {0}%}" Style="{DynamicResource CaptionStyle}" Margin="0,8,0,4" />
                        <Slider Minimum="10" Maximum="100" Value="{Binding Settings.MaxCpuUsageLimit}" />
                        
                        <TextBlock Text="{Binding Settings.MaxGpuUsageLimit, StringFormat=Max GPU Usage: {0}%}" Style="{DynamicResource CaptionStyle}" Margin="0,12,0,4" />
                        <Slider Minimum="10" Maximum="100" Value="{Binding Settings.MaxGpuUsageLimit}" />
                        
                        <TextBlock Text="{Binding Settings.MaxRamUsageLimitMb, StringFormat=Max RAM Usage: {0} MB}" Style="{DynamicResource CaptionStyle}" Margin="0,12,0,4" />
                        <Slider Minimum="256" Maximum="16384" TickFrequency="256" IsSnapToTickEnabled="True" Value="{Binding Settings.MaxRamUsageLimitMb}" />
                        
                        <TextBlock Text="{Binding Settings.MaxVramUsageLimitMb, StringFormat=Max System VRAM Usage: {0} MB}" Style="{DynamicResource CaptionStyle}" Margin="0,12,0,4" />
                        <Slider Minimum="128" Maximum="8192" TickFrequency="128" IsSnapToTickEnabled="True" Value="{Binding Settings.MaxVramUsageLimitMb}" />
                        
                        <TextBlock Text="Action when exceeded:" Style="{DynamicResource CaptionStyle}" Margin="0,16,0,8" />
                        <ComboBox ItemsSource="{Binding ResourceExceedActions}" SelectedItem="{Binding Settings.ResourceLimitExceededAction}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SAVE / RESET BUTTONS -->
            <Border Style="{DynamicResource PanelStyle}" Margin="0,0,16,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset to Default" Command="{Binding ResetSettingsCommand}" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16,8" Margin="0,0,12,0" />
                    <Button Content="Save Changes" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource PrimaryButtonStyle}" Padding="24,8" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
