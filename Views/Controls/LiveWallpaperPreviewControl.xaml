<UserControl x:Class="LiveWallpaperApp.Views.Controls.LiveWallpaperPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             IsVisibleChanged="OnIsVisibleChanged">
    <Border CornerRadius="18"
            ClipToBounds="True"
            Background="#080B10">
        <Grid>
            <vlc:VideoView x:Name="PreviewVideo"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />

            <Border Background="{DynamicResource PreviewOverlayBrush}"
                    VerticalAlignment="Bottom"
                    Height="54">
                <DockPanel Margin="16,0">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=StateText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="Dashboard Preview"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
