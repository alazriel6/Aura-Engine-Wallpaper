<UserControl x:Class="LiveWallpaperApp.Views.Controls.AnimatedThumbnailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             IsVisibleChanged="OnIsVisibleChanged">
    <Border CornerRadius="14"
            ClipToBounds="True"
            Background="#101318">
        <Grid>
            <vlc:VideoView x:Name="PreviewVideo"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />

            <Border Background="{DynamicResource PreviewOverlayBrush}"
                    VerticalAlignment="Bottom"
                    Height="42">
                <Grid Margin="12,0">
                    <TextBlock x:Name="StateText"
                               Text="Hover to preview"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
