<Window x:Class="LiveWallpaperApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:helpers="clr-namespace:LiveWallpaperApp.Helpers"
        xmlns:controls="clr-namespace:LiveWallpaperApp.Views.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:LiveWallpaperApp.Views"
        mc:Ignorable="d"
        Title="Live Wallpaper Studio"
        Width="1280"
        Height="840"
        MinWidth="1180"
        MinHeight="740"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBgBrush}"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Icon="/Assets/AppIcon.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0,1,0,0" CornerRadius="0" CaptionHeight="54" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <helpers:BooleanToRedHeartConverter x:Key="BooleanToRedHeartConverter" />
        <helpers:BooleanToStringConverter x:Key="BooleanToStringConverter" />
        <helpers:RatingToStarFontConverter x:Key="RatingToStarFontConverter" />
        <helpers:PageVisibilityConverter x:Key="PageVisibilityConverter" />
        <helpers:StringMatchToBooleanConverter x:Key="StringMatchToBooleanConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <helpers:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter" />
        <helpers:AspectRatioConverter x:Key="AspectRatioConverter" />
        <helpers:EqualityMultiConverter x:Key="EqualityMultiConverter" />
        <helpers:MultiParameterConverter x:Key="MultiParameterConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <!-- SLEEK SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="2" Width="4" HorizontalAlignment="Right" Background="#4DFFFFFF" Margin="0,2,2,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="2" Height="4" VerticalAlignment="Bottom" Background="#4DFFFFFF" Margin="2,0,2,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource GlobalCornerRadius}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource BorderGlowColor}" 
                                      BlurRadius="{DynamicResource GlobalBlurRadius}" 
                                      ShadowDepth="0" 
                                      Opacity="{DynamicResource GlobalGlowOpacity}" 
                                      RenderingBias="Performance" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinHeight" Value="84" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageContainerStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryToggleStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GroupName" Value="CategoryFilter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2AFFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBgBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Padding="18,0"
                    Background="{DynamicResource WindowTitleBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="9" Margin="0,0,12,0">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/AppIcon.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Live Wallpaper Studio" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource WindowControlButtonStyle}" Click="OnMinimizeClick" />
                        <Button Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource WindowControlButtonStyle}" Click="OnMaximizeRestoreClick" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource ChromeCloseButtonStyle}" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,4,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,12" />
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Home}" Command="{Binding SelectPageCommand}" CommandParameter="Home">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Playlist}" Command="{Binding SelectPageCommand}" CommandParameter="Playlist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE142;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Playlist" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Performance}" Command="{Binding SelectPageCommand}" CommandParameter="Performance">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Performance" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Settings}" Command="{Binding SelectPageCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Monitors}" Command="{Binding SelectPageCommand}" CommandParameter="Monitors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Monitors" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Marketplace}" Command="{Binding SelectPageCommand}" CommandParameter="Marketplace">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="Marketplace" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=About}" Command="{Binding SelectPageCommand}" CommandParameter="About">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="About" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Margin="16" Padding="16" Background="{DynamicResource OverlayBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RESOURCE MONITOR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />
                                
                                <!-- CPU -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="CPU" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding LiveCpuUsage}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                </Grid>

                                <!-- GPU -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE81E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="GPU" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding LiveGpuUsage}" Foreground="#FF3366" FontWeight="SemiBold" FontSize="12" />
                                </Grid>

                                <!-- RAM -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="RAM" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding LiveRamUsage}" Foreground="#33FF99" FontWeight="SemiBold" FontSize="12" />
                                </Grid>

                                <!-- FPS -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="FPS" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding LiveFps}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                
                                <Border Background="#1AFFFFFF" Height="1" Margin="0,12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Runtime:" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding LiveRunningTime}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Filler border so the DockPanel LastChildFill doesn't stretch the Resource Mode box -->
                        <Border />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid Style="{StaticResource PageContainerStyle}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Home}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE: LIBRARY GRID -->
                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <StackPanel Margin="18,18,18,14">
                                    <!-- STATS WIDGETS -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#11FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Installed Wallpapers" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding InstalledCount}" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#11FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Favorites" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding FavoritesCount}" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="#11FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Playlists" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding PlaylistsCount}" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="6" Background="#11FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Storage Used" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding TotalStorageGb}" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ACTION BAR (Search & Buttons) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- PREMIUM SEARCH BAR -->
                                        <Border Grid.Column="0" Height="44" CornerRadius="22" Background="#11FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.3" RenderingBias="Performance"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="16" Margin="20,0,12,0" />
                                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalAlignment="Center" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" Margin="0,0,20,0" />
                                                <TextBlock Grid.Column="1" Text="Search your universe..." Foreground="#64748B" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,20,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSortMode}" Height="44" />
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding GridColumnsOptions}" SelectedItem="{Binding GridColumns}" Height="44" ToolTip="Columns per row" />
                                        <Button Grid.Column="6" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Command="{Binding AddFolderCommand}" Height="44" />
                                        <Button Grid.Column="8" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Command="{Binding RefreshLibraryCommand}" Height="44" />
                                    </Grid>
                                    
                                    <!-- QUICK FILTER TAGS -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding}" 
                                                                 Style="{StaticResource CategoryToggleStyle}" 
                                                                 Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding}">
                                                        <RadioButton.IsChecked>
                                                            <MultiBinding Converter="{StaticResource EqualityMultiConverter}" Mode="OneWay">
                                                                <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="." />
                                                            </MultiBinding>
                                                        </RadioButton.IsChecked>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredLibraryPreviews}"
                                         ItemContainerStyle="{StaticResource CardItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="18,0,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="18,0,0,0" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatioConverter}}"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource SoftPanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Add to Playlist" Command="{Binding DataContext.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                                        <TranslateTransform x:Name="CardTranslate" X="0" Y="0" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="CardShadow" Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.15" RenderingBias="Performance" />
                                                </Border.Effect>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderGlowBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActiveWallpaper}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#06B6D4"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlayTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                                                <DoubleAnimation Storyboard.TargetName="HoverOverlayTransform" Storyboard.TargetProperty="Y" To="10" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Grid Cursor="Hand" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <Grid.ContextMenu>
                                                        <ContextMenu Background="#1A0F172A" BorderBrush="#33FFFFFF" Foreground="#F8FAFC">
                                                            <MenuItem Header="Apply Wallpaper" Command="{Binding PlacementTarget.Tag.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Add to Favorites" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                            <MenuItem Header="Add to Playlist" 
                                                                      ItemsSource="{Binding PlacementTarget.Tag.PlaylistService.AllPlaylists, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.ItemContainerStyle>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="Header" Value="{Binding Name}" />
                                                                        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.AddToSpecificPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        <Setter Property="CommandParameter">
                                                                            <Setter.Value>
                                                                                <MultiBinding Converter="{StaticResource MultiParameterConverter}">
                                                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                                    <Binding Path="" />
                                                                                </MultiBinding>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </MenuItem.ItemContainerStyle>
                                                            </MenuItem>
                                                            <Separator Background="#33FFFFFF" />
                                                            <MenuItem Header="Open in Explorer" Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Border CornerRadius="13" ClipToBounds="True">
                                                        <Grid>
                                                            <!-- ACTIVE GLOW BORDER -->
                                                            <Border BorderBrush="#06B6D4" BorderThickness="2" CornerRadius="13" Panel.ZIndex="1" Opacity="0" IsHitTestVisible="False">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#06B6D4" BlurRadius="15" ShadowDepth="0" RenderingBias="Performance" />
                                                                </Border.Effect>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActiveWallpaper}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard Name="PulseStoryboard">
                                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:1.5">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <SineEase EasingMode="EaseInOut" />
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            
                                                            <!-- THUMBNAIL -->
                                                            <Image Stretch="UniformToFill" 
                                                                   Source="{Binding PreviewPath, IsAsync=True}"
                                                                   Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            </Image>
                                                            
                                                            <!-- FALLBACK NO_SIGNAL -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" Fill="#64748b" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                                                <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="NO_SIGNAL" Foreground="#64748b" FontFamily="Consolas" FontSize="10"/>
                                                                </Border>
                                                            </StackPanel>
                                                            
                                                            <!-- PREMIUM HOVER OVERLAY -->
                                                            <Border x:Name="HoverOverlay" Opacity="0" Background="#E60F172A">
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform x:Name="HoverOverlayTransform" Y="10" />
                                                                </Border.RenderTransform>
                                                                <Grid Margin="12">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    
                                                                    <StackPanel Grid.Row="0">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}" />
                                                                        
                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                            <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0" />
                                                                            <TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="#94A3B8" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    
                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                                                        <Button Style="{StaticResource TransparentButtonStyle}" Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,12,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Preview" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Style="{StaticResource TransparentButtonStyle}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,12,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xEB51;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding IsFavorite, Converter={StaticResource BooleanToRedHeartConverter}}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Favorite" Foreground="{Binding IsFavorite, Converter={StaticResource BooleanToRedHeartConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Style="{StaticResource TransparentButtonStyle}" Command="{Binding DataContext.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Playlist" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            
                                                            <!-- ACTIVE INDICATOR -->
                                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Background="#06B6D4" CornerRadius="4" Padding="6,2" Visibility="{Binding IsActiveWallpaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="ACTIVE" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- EMPTY STATE PLACEHOLDER -->
                                <Grid Grid.Row="1" Visibility="{Binding FilteredLibraryPreviews.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#3394A3B8" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                        <TextBlock Text="No Wallpapers Found" Foreground="#94A3B8" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Drag wallpapers here or import from local files" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" />
                                        <Button Content="Import Wallpaper" Command="{Binding ImportToLibraryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,8" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RIGHT SIDE: PREMIUM DETAILS & PREVIEW -->
                        <Grid Grid.Column="2">

                            <!-- DETAILS PANEL (SCROLLABLE) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <Border Style="{StaticResource PanelStyle}" Padding="0" ClipToBounds="True" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Margin="18,18,18,12" CornerRadius="12" ClipToBounds="True">
                                        <Grid>
                                            <!-- The Video Preview -->
                                            <Border>
                                                <controls:LiveWallpaperPreviewControl VideoPath="{Binding VideoPath}"
                                                                                      PlayerOptions="{Binding ThumbnailVlcOptions}"
                                                                                      IsPreviewActive="{Binding IsDashboardActive}" />
                                            </Border>
                                            <!-- Subtle gradient overlay at the bottom -->
                                            <Border VerticalAlignment="Bottom" Height="80" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#000F172A" Offset="0"/>
                                                        <GradientStop Color="#C80F172A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            
                                            <!-- Author Tag overlay -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B3000000" CornerRadius="6" Padding="8,4" Margin="12">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedPreviewItem.Author, FallbackValue='Local User'}" FontSize="11" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <StackPanel Margin="18,0,18,18">
                                        <TextBlock Text="{Binding SelectedPreviewItem.DisplayName, FallbackValue='Select a Wallpaper'}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16" Visibility="{Binding SelectedPreviewItem, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedPreviewItem}" Style="{StaticResource TransparentButtonStyle}" Padding="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEB51;" Foreground="{Binding SelectedPreviewItem.IsFavorite, Converter={StaticResource BooleanToRedHeartConverter}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedPreviewItem.IsFavorite, Converter={StaticResource BooleanToStringConverter}, ConverterParameter=Favorited|Favorite}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <TextBlock Text="&#xE896;" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPreviewItem.Wallpaper.ImportedAt, StringFormat=dd MMM yyyy}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE823;" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPreviewItem.Wallpaper.LastUsedAt, StringFormat=dd MMM yyyy}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- CONDITIONAL PANEL (Only visible when wallpaper is selected) -->
                                        <StackPanel Visibility="{Binding SelectedPreviewItem, Converter={StaticResource NullToVisibilityConverter}}">
                                            <!-- METADATA GRID -->
                                            <Grid Margin="0,0,0,24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Author" Foreground="#94A3B8" Margin="0,0,16,8" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPreviewItem.Author}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution" Foreground="#94A3B8" Margin="0,0,16,8" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPreviewItem.Resolution}" Foreground="#E2E8F0" />
                                                
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration" Foreground="#94A3B8" Margin="0,0,16,8" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPreviewItem.Duration}" Foreground="#E2E8F0" />
                                                
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Size" Foreground="#94A3B8" Margin="0,0,16,8" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPreviewItem.FileSizeText}" Foreground="#E2E8F0" />
                                                
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tags" Foreground="#94A3B8" Margin="0,0,16,0" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPreviewItem.TagsText}" Foreground="#06B6D4" TextWrapping="Wrap" />
                                            </Grid>

                                            <TextBlock Text="Display Monitor" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <!-- MULTI-MONITOR VISUAL MAP -->
                                            <ListBox ItemsSource="{Binding MonitorSelections}" 
                                                     SelectedValue="{Binding SelectedMonitorDeviceName}" 
                                                     SelectedValuePath="DeviceName"
                                                     Background="Transparent" BorderThickness="0" Margin="0,0,0,16"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                                        <Setter Property="Padding" Value="12,8"/>
                                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter Property="Background" Value="#3306B6D4" />
                                                                            <Setter Property="BorderBrush" Value="#06B6D4" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#33FFFFFF" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Playback Actions -->
                                                <Button Grid.Row="0" Grid.Column="0" Content="&#xE73E;  Apply" ToolTip="Apply Wallpaper" FontSize="12" MinWidth="0" Padding="8,6" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding ApplyCommand}" CommandParameter="{Binding SelectedPreviewItem}" />
                                                <Button Grid.Row="0" Grid.Column="2" Content="&#xE15B;  Stop" ToolTip="Stop Wallpaper" FontSize="12" MinWidth="0" Padding="8,6" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StopCommand}" />
                                                
                                                <!-- Library Actions -->
                                                <Button Grid.Row="2" Grid.Column="0" Content="&#xE00B;  Fav" ToolTip="Favorite" FontSize="12" MinWidth="0" Padding="8,6" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedPreviewItem}" />
                                                <Button x:Name="ListBtn" Grid.Row="2" Grid.Column="2" Content="&#xE109;  List" ToolTip="Add to Playlist" FontSize="12" MinWidth="0" Padding="8,6" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddToPlaylistCommand}" CommandParameter="{Binding SelectedPreviewItem}" />
                                            </Grid>

                                            <StackPanel Margin="0,24,0,0">
                                                <TextBlock Text="CURRENT WALLPAPER" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4" />
                                                <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,4" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Playing" Foreground="#E2E8F0" FontSize="11" />
                                                    
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,4" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LiveRunningTime}" Foreground="#E2E8F0" FontSize="11" />
                                                    
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Loops" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,4" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LiveLoops}" Foreground="#E2E8F0" FontSize="11" />
                                                    
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,4" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LiveCpuUsage}" Foreground="#E2E8F0" FontSize="11" />
                                                    
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="GPU" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,4" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LiveGpuUsage}" Foreground="#E2E8F0" FontSize="11" />
                                                    
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sys VRAM" ToolTip="Total System VRAM in use (Not just this app)" Foreground="#94A3B8" FontSize="11" Margin="0,0,40,0" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LiveRamUsage}" Foreground="#E2E8F0" FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>



                    <!-- PLAYLIST VIEW -->
                    <ScrollViewer Style="{StaticResource PageContainerStyle}" Padding="32,32,24,32" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Playlist}">
                        <ScrollViewer.Resources>
                            <!-- Custom sleek segmented button style -->
                            <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6" Margin="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <helpers:InverseCountToVisibilityConverter x:Key="PlaylistInverseCountToVisibilityConverter" />
                        </ScrollViewer.Resources>

                        <StackPanel>
                            
                            <!-- Clean Premium Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE142;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Playlists" Style="{StaticResource TitleTextStyle}" FontSize="24" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Create and manage wallpaper playlists with custom rotation settings." Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ═══ LEFT SIDEBAR: Playlist List ═══ -->
                                <Border Grid.Column="0" VerticalAlignment="Top" Background="{DynamicResource SoftPanelBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Effect="{DynamicResource SubtleShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- New Playlist Button -->
                                        <Button Grid.Row="0" Command="{Binding CreatePlaylistCommand}" CommandParameter="New Playlist" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="40" Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="New Playlist" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Playlist Items -->
                                            <ListBox Grid.Row="1" ItemsSource="{Binding PlaylistService.AllPlaylists}" 
                                                     SelectedItem="{Binding PlaylistService.SelectedPlaylist, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,2" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,10">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverPanelBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding WallpaperCount, Mode=OneWay}" />
                                                                    <Run Text=" wallpapers" />
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <!-- Active indicator dot -->
                                                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource EqualityMultiConverter}">
                                                                                        <Binding Path="Id" />
                                                                                        <Binding Path="DataContext.PlaylistService.ActivePlaylist.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Fill" Value="#22C55E" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>

                                                            <Grid.ContextMenu>
                                                                <ContextMenu Background="#1A0F172A" BorderBrush="#33FFFFFF" Foreground="#F8FAFC">
                                                                    <MenuItem Header="Set as Active" Command="{Binding PlacementTarget.Tag.SetActivePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                                    <Separator Background="#33FFFFFF" />
                                                                    <MenuItem Header="Delete Playlist" Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                                </ContextMenu>
                                                            </Grid.ContextMenu>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Empty state for no playlists -->
                                            <StackPanel Grid.Row="1" Visibility="{Binding PlaylistService.AllPlaylists.Count, Converter={StaticResource PlaylistInverseCountToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,24,0,0">
                                                <TextBlock Text="No playlists yet" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
                                            </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ═══ CENTER: Selected Playlist Content ═══ -->
                                <Grid Grid.Column="2" Visibility="{Binding PlaylistService.SelectedPlaylist, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Playlist header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBox Text="{Binding SelectedPlaylistName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" 
                                                         Background="Transparent" BorderThickness="0" Padding="0" Margin="-2,0,0,0" 
                                                         VerticalAlignment="Center" ToolTip="Click to rename playlist">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding RenamePlaylistCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0">
                                                    <Run Text="{Binding PlaylistService.SelectedPlaylistItems.Count, Mode=OneWay}" />
                                                    <Run Text=" ITEMS" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Playlist Settings Horizontal Bar -->
                                        <Border Grid.Row="1" Background="{DynamicResource SoftPanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,24">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Playback Mode -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Playback Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="4" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <RadioButton Grid.Column="0" Content="Sequential" IsChecked="{Binding PlaylistService.SelectedPlaylist.IsSequential, Mode=TwoWay}" GroupName="ModeGroup" Style="{StaticResource SegmentedRadioButtonStyle}" />
                                                            <RadioButton Grid.Column="1" Content="Random" IsChecked="{Binding PlaylistService.SelectedPlaylist.IsSequential, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" GroupName="ModeGroup" Style="{StaticResource SegmentedRadioButtonStyle}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Change Interval -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Change Interval" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                                                    <ComboBox SelectedValue="{Binding PlaylistService.SelectedPlaylist.Interval, Mode=TwoWay}" SelectedValuePath="Tag" Background="{DynamicResource PanelBrush}" Padding="16,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" MinWidth="180">
                                                        <ComboBox.Resources>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Padding" Value="12,8" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                            </Style>
                                                        </ComboBox.Resources>
                                                        <ComboBoxItem Content="Every 5 Minutes">
                                                            <ComboBoxItem.Tag>
                                                                <sys:TimeSpan xmlns:sys="clr-namespace:System;assembly=mscorlib">00:05:00</sys:TimeSpan>
                                                            </ComboBoxItem.Tag>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem Content="Every 30 Minutes">
                                                            <ComboBoxItem.Tag>
                                                                <sys:TimeSpan xmlns:sys="clr-namespace:System;assembly=mscorlib">00:30:00</sys:TimeSpan>
                                                            </ComboBoxItem.Tag>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem Content="Every 1 Hour">
                                                            <ComboBoxItem.Tag>
                                                                <sys:TimeSpan xmlns:sys="clr-namespace:System;assembly=mscorlib">01:00:00</sys:TimeSpan>
                                                            </ComboBoxItem.Tag>
                                                        </ComboBoxItem>
                                                        <ComboBoxItem Content="On Startup Only">
                                                            <ComboBoxItem.Tag>
                                                                <sys:TimeSpan xmlns:sys="clr-namespace:System;assembly=mscorlib">00:00:00</sys:TimeSpan>
                                                            </ComboBoxItem.Tag>
                                                        </ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Set Active / Stop Button -->
                                                <Button Grid.Column="4" Command="{Binding SetActivePlaylistCommand}" VerticalAlignment="Bottom" Height="40" Padding="24,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="CommandParameter" Value="{Binding PlaylistService.SelectedPlaylist}" />
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                        <TextBlock Text="Set as Active" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                    </StackPanel>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource EqualityMultiConverter}">
                                                                            <Binding Path="PlaylistService.SelectedPlaylist.Id" />
                                                                            <Binding Path="PlaylistService.ActivePlaylist.Id" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="CommandParameter" Value="Deactivate" />
                                                                    <Setter Property="Background" Value="#1AEF4444" />
                                                                    <Setter Property="BorderBrush" Value="#33EF4444" />
                                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE106;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                                <TextBlock Text="Stop Playlist" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                            </StackPanel>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Wallpaper cards grid -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding PlaylistService.SelectedPlaylistItems}"
                                                 dd:DragDrop.IsDragSource="True"
                                                 dd:DragDrop.IsDropTarget="True"
                                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,0"
                                                 ItemContainerStyle="{StaticResource CardItemStyle}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SoftPanelBrush}" CornerRadius="12" Margin="0,0,16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="260" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="146" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Thumbnail -->
                                                            <Grid Grid.Row="0">
                                                                <Image Stretch="UniformToFill" Source="{Binding PreviewPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                                                                
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewPath, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" Fill="#64748b" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                                    <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Text="NO SIGNAL" Foreground="#64748b" FontFamily="Consolas" FontSize="10"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Remove Button (Top Right of Image) -->
                                                                <Button Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Width="32" Height="32" Padding="0"
                                                                        Background="#80000000" Foreground="#F8FAFC" BorderThickness="0"
                                                                        ToolTip="Remove from Playlist" Cursor="Hand">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bg" Property="Background" Value="#EF4444" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>

                                                            <!-- Details -->
                                                            <StackPanel Grid.Row="1" Margin="14,12">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                                <TextBlock Text="Wallpaper" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty state for no items in playlist -->
                                        <StackPanel Grid.Row="2" Visibility="{Binding PlaylistService.SelectedPlaylistItems.Count, Converter={StaticResource PlaylistInverseCountToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                                            <TextBlock Text="&#xE142;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                            <TextBlock Text="This playlist is empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#E2E8F0" />
                                            <TextBlock Text="Right-click any wallpaper in Home to add it here." Foreground="#94A3B8" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <views:PerformanceControlCenter Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Performance}" />

                    <ScrollViewer Style="{StaticResource PageContainerStyle}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
                        <Grid Margin="0,0,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header and Search -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Settings" Style="{DynamicResource TitleTextStyle}" FontSize="24" Margin="0,0,0,4" />
                                    <TextBlock Text="Configure application behavior and appearance." Style="{DynamicResource CaptionStyle}" />
                                </StackPanel>
                                
                                <!-- PREMIUM SEARCH BAR (Settings) -->
                                <Border Grid.Column="1" Height="40" Background="#11FFFFFF" CornerRadius="20" Padding="16,0" BorderThickness="1.5" BorderBrush="#22FFFFFF" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.3" RenderingBias="Performance"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" FontSize="15" />
                                        <TextBox Grid.Column="1" Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}" Foreground="White" />
                                        <TextBlock Grid.Column="1" Text="Search settings..." Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SettingsSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SettingsSearchText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Masonry Content -->
                            <StackPanel Grid.Row="2">
                                
                                <!-- DASHBOARD HEADER -->
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- SYSTEM HEALTH -->
                                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="System Health" Style="{StaticResource TitleTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SystemHealthService.HealthScore}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding SystemHealthService.SystemStatus}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SystemHealthService.Recommendation}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- SUMMARY -->
                                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Settings Summary" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Current Theme" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Settings.SelectedTheme}" FontWeight="Medium" />
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Storage Usage" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TotalStorageGb}" FontWeight="Medium" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- TWO-COLUMN MASONRY -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /> <!-- Left Column -->
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" /> <!-- Right Column -->
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN -->
                                    <StackPanel Grid.Column="0">
                                    <!-- GENERAL CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="General" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            <CheckBox Content="Launch on startup" IsChecked="{Binding IsStartupEnabled}" Margin="0,0,0,8" />
                                            <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized}" Margin="0,0,0,8" />
                                            <CheckBox Content="Show tray icon" IsChecked="{Binding Settings.ShowTrayIcon}" Margin="0,0,0,8" />
                                            <CheckBox Content="Minimize to tray" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,0,0,8" />
                                            <CheckBox Content="Close to tray" IsChecked="{Binding Settings.CloseToTray}" Margin="0,0,0,8" />
                                            <CheckBox Content="Restore wallpaper automatically" IsChecked="{Binding Settings.AutoRestoreWallpaper}" Margin="0,0,0,8" />
                                            <CheckBox Content="Check updates automatically" IsChecked="{Binding Settings.CheckForUpdatesAutomatically}" Margin="0,0,0,8" />
                                            <CheckBox Content="Run as administrator" IsChecked="{Binding Settings.RunAsAdministrator}" Margin="0,0,0,8" />
                                            <CheckBox Content="Send anonymous diagnostics" IsChecked="{Binding Settings.SendAnonymousDiagnostics}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- WALLPAPER CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Wallpaper Controls" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            <CheckBox Content="Loop wallpaper" IsChecked="{Binding Settings.LoopWallpaper}" Margin="0,0,0,8" />
                                            <CheckBox Content="Auto shuffle" IsChecked="{Binding Settings.AutoShuffle}" Margin="0,0,0,8" />
                                            <CheckBox Content="Sync monitors" IsChecked="{Binding Settings.MultiMonitorSync}" Margin="0,0,0,8" />
                                            <CheckBox Content="Auto apply last wallpaper" IsChecked="{Binding Settings.AutoApplyLastWallpaper}" Margin="0,0,0,16" />

                                            <TextBlock Text="Change Interval (Minutes)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <ComboBox SelectedItem="{Binding Settings.WallpaperChangeIntervalMinutes}" Margin="0,0,0,16">
                                                <ComboBox.ItemsSource>
                                                    <x:Array Type="System:Int32" xmlns:System="clr-namespace:System;assembly=mscorlib">
                                                        <System:Int32>5</System:Int32>
                                                        <System:Int32>15</System:Int32>
                                                        <System:Int32>30</System:Int32>
                                                        <System:Int32>60</System:Int32>
                                                        <System:Int32>180</System:Int32>
                                                        <System:Int32>360</System:Int32>
                                                        <System:Int32>720</System:Int32>
                                                        <System:Int32>1440</System:Int32>
                                                    </x:Array>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>

                                            <TextBlock Text="Quality &amp; Rendering" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,12" />
                                            
                                            <TextBlock Text="{Binding Settings.PreviewQuality, StringFormat=Preview Quality {0}%}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="10" Maximum="100" Value="{Binding Settings.PreviewQuality}" Margin="0,0,0,16" />
                                            
                                            <TextBlock Text="{Binding Settings.LiveThumbnailQuality, StringFormat=Thumbnail Quality {0}%}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="10" Maximum="100" Value="{Binding Settings.LiveThumbnailQuality}" Margin="0,0,0,16" />

                                            <CheckBox Content="Hardware Decode (Requires Restart)" IsChecked="{Binding Settings.HardwareVideoDecoding}" />
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- SCHEDULER CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Wallpaper Scheduler" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
                                            <TextBlock Text="Coming soon in a future update. Create time-based rules to change wallpapers automatically." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- USER PRESETS CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Performance Presets" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            
                                            <ItemsControl ItemsSource="{Binding ProfileService.BuiltInProfiles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,0,8" Padding="12" Background="{DynamicResource SoftPanelBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- BACKUP AND RECOVERY CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Backup &amp; Recovery" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Settings Backup Status" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Grid.Column="1" Text="Saved locally" FontWeight="Medium" />
                                            </Grid>
                                            
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Thumbnail Cache Size" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Grid.Column="1" Text="12.4 MB" FontWeight="Medium" />
                                            </Grid>

                                            <UniformGrid Columns="2">
                                                <Button Content="Export Settings" Command="{Binding ExportSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,8" HorizontalAlignment="Stretch" />
                                                <Button Content="Import Settings" Command="{Binding ImportSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,8" HorizontalAlignment="Stretch" />
                                                <Button Content="Export Theme" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,8" HorizontalAlignment="Stretch" />
                                                <Button Content="Import Theme" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,8" HorizontalAlignment="Stretch" />
                                                <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" HorizontalAlignment="Stretch" Foreground="#ff3333" />
                                                <Button Content="Clear Cache" Command="{Binding ClearCacheCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                    <!-- RIGHT COLUMN -->
                                    <StackPanel Grid.Column="2">
                                    <!-- APPEARANCE CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Appearance" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            
                                            <!-- Theme visual cards -->
                                            <ItemsControl ItemsSource="{Binding ThemeCards}" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding ApplyCommand}" Margin="0,0,8,8" Padding="12,8" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="20" Height="20" CornerRadius="10" Background="{Binding PreviewColorHex}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0"/>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Accent Color" Style="{StaticResource CaptionStyle}" Margin="0,16,0,8" />
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding BrowseAccentColorCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Pick a color">
                                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                </Button>
                                                <TextBox Grid.Column="2" Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Content="Apply" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyAccentCommand}" />
                                            </Grid>

                                            <TextBlock Text="UI Scale" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <ComboBox ItemsSource="{Binding UiScaleOptions}" SelectedItem="{Binding Settings.UiScale}" Margin="0,0,0,16" />
                                            
                                            <TextBlock Text="Interface Feel" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,12,0,12" />
                                            
                                            <TextBlock Text="{Binding Settings.BlurStrength, StringFormat=Blur Strength {0:0}}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="0" Maximum="40" Value="{Binding Settings.BlurStrength}" Margin="0,0,0,16" />
                                            
                                            <TextBlock Text="{Binding Settings.GlowIntensity, StringFormat=Glow Strength {0:P0}}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="0" Maximum="1" Value="{Binding Settings.GlowIntensity}" Margin="0,0,0,16" />

                                            <TextBlock Text="{Binding Settings.AnimationSpeed, StringFormat=Animation Speed {0:F1}x}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="0.5" Maximum="2.0" Value="{Binding Settings.AnimationSpeed}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- AUDIO CARD -->
                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock Text="Wallpaper Audio" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                            <CheckBox Content="Mute wallpaper audio" IsChecked="{Binding Settings.MuteWallpaperAudio}" Margin="0,0,0,8" />
                                            <CheckBox Content="Mute when fullscreen app running" IsChecked="{Binding Settings.MuteWhenFullscreen}" Margin="0,0,0,8" />
                                            <CheckBox Content="Mute when game running" IsChecked="{Binding Settings.PauseFullscreenGame}" Margin="0,0,0,8" />
                                            <CheckBox Content="Mute when another app focused" IsChecked="{Binding Settings.MuteWhenUnfocused}" Margin="0,0,0,8" />
                                            <CheckBox Content="Smooth fade transitions" IsChecked="{Binding Settings.AudioFadeTransitions}" Margin="0,0,0,16" />
                                            
                                            <TextBlock Text="{Binding Settings.MasterVolume, StringFormat=Volume Slider {0}%}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Settings.MasterVolume}" Margin="0,0,0,16" />

                                            <!-- Audio Visualizer Preview -->
                                            <TextBlock Text="Audio Visualizer Preview" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <Border Height="40" Background="{DynamicResource SoftPanelBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                <!-- Mock Visualizer Bars -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,8">
                                                    <Border Width="6" Height="10" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.8"/>
                                                    <Border Width="6" Height="24" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.9"/>
                                                    <Border Width="6" Height="18" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.7"/>
                                                    <Border Width="6" Height="8"  CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.6"/>
                                                    <Border Width="6" Height="20" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.8"/>
                                                    <Border Width="6" Height="14" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.7"/>
                                                    <Border Width="6" Height="22" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="2,0" Opacity="0.9"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    </StackPanel>
                                </Grid>

                                <!-- SAVE / RESET BUTTONS -->
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Reset to Default" Command="{Binding ResetSettingsCommand}" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="16,8" Margin="0,0,12,0" />
                                        <Button Content="Save Changes" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="24,8" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ============================================== -->
                    <!-- MONITORS PAGE -->
                    <!-- ============================================== -->
                    <ScrollViewer Style="{StaticResource PageContainerStyle}" Padding="32,32,24,32" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Monitors}">
                        <StackPanel DataContext="{Binding MonitorVM}">
                            <!-- PAGE HEADER -->
                            <TextBlock Text="Monitors" Style="{DynamicResource TitleTextStyle}" FontSize="24" />
                            <TextBlock Text="Manage multi-monitor setups, performance, and wallpaper assignments." Style="{DynamicResource CaptionStyle}" Margin="0,0,0,24" />

                            <!-- 1. MONITOR OVERVIEW -->
                            <TextBlock Text="Monitor Overview" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,16" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,32">
                                <ListBox ItemsSource="{Binding Monitors}" 
                                         SelectedItem="{Binding SelectedMonitor}" 
                                         ItemContainerStyle="{StaticResource MonitorCardListBoxItemStyle}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MonitorCardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Background="{DynamicResource AccentBrush}" Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Margin="0,0,0,8">
                                                        <TextBlock Text="Primary Monitor" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                    
                                                    <TextBlock Text="{Binding ResolutionString}" Style="{DynamicResource CaptionStyle}" />
                                                    <TextBlock Text="{Binding RefreshRate, StringFormat={}{0}Hz}" Style="{DynamicResource CaptionStyle}" />
                                                    <TextBlock Text="{Binding IsHdrEnabled, StringFormat=HDR Enabled}" Visibility="{Binding IsHdrEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#A855F7" FontWeight="Medium" FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>

                            <!-- 2. MONITOR ARRANGEMENT -->
                            <TextBlock Text="Monitor Arrangement" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,16" />
                            <Border Style="{StaticResource PanelStyle}" Height="300" Margin="0,0,0,32" Background="#0Affffff">
                                <Grid>
                                    <ListBox ItemsSource="{Binding Monitors}" 
                                             SelectedItem="{Binding SelectedMonitor}"
                                             ItemContainerStyle="{StaticResource MonitorCanvasListBoxItemStyle}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding CanvasMargin}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Monitor Screen Body -->
                                                    <Border Background="#11FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="8" Margin="8,8,8,20">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Background" Value="#224F46E5" />
                                                                        <Setter Property="Effect">
                                                                            <Setter.Value>
                                                                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.6" RenderingBias="Performance" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="2,4,2,2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <!-- Inner Screen bezel shadow -->
                                                        <Border Background="#0A000000" CornerRadius="6" Margin="4">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding ResolutionString}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Border>

                                                    <!-- Monitor Stand Base -->
                                                    <Path Grid.Row="1" Fill="{DynamicResource BorderBrush}" Stretch="Fill" Height="12" Width="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Data="M 0,12 L 10,0 L 30,0 L 40,12 Z" Opacity="0.5" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- 3. MONITOR DETAILS & ASSIGNMENT -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Details -->
                                <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Monitor Details" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,16" />
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Resolution:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.ResolutionString}" FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Refresh Rate:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.RefreshRate, StringFormat={}{0} Hz}" FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Scaling:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.ScalingPercentage, StringFormat={}{0}%}" FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="HDR:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.IsHdrEnabled, StringFormat=Enabled}" FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                     </StackPanel>
                                </Border>

                                <!-- Assignment -->
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Wallpaper Assignment" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,16" />
                                        
                                        <TextBlock Text="Wallpaper Mode" Style="{DynamicResource CaptionStyle}" Margin="0,0,0,8" />
                                        <ComboBox ItemsSource="{Binding WallpaperModes}" SelectedItem="{Binding SelectedWallpaperMode}" Margin="0,0,0,16" />
                                        
                                        <TextBlock Text="Current Wallpaper" Style="{DynamicResource CaptionStyle}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding SelectedMonitor.CurrentWallpaperName}" FontWeight="SemiBold" Margin="0,0,0,24" />
                                        
                                        <Button Content="Change Wallpaper" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChangeWallpaperCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12" Height="36" />
                                        <Button Content="Sync All Monitors" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SyncWallpapersCommand}" HorizontalAlignment="Stretch" Height="36" />
                                    </StackPanel>
                                </Border>

                                <!-- Performance -->
                                <Border Grid.Column="4" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Performance" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,16" />
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GPU Usage:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.Performance.GpuUsage, StringFormat={}{0:F1}%}" FontWeight="Medium" Foreground="#10B981" TextAlignment="Right" />
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VRAM:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.Performance.VramUsageMb, StringFormat={}{0:F0} MB}" FontWeight="Medium" TextAlignment="Right" />
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Render FPS:" Style="{DynamicResource CaptionStyle}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.Performance.Fps}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" />
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Status:" Style="{DynamicResource CaptionStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.HealthStatus}" FontWeight="Medium" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Style="{StaticResource PageContainerStyle}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Marketplace}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Browser Navigation Bar -->
                        <Border Grid.Row="0" Margin="0,0,16,16" Background="{DynamicResource SoftPanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowserBackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BrowserBackButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="BrowserForwardButton" Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BrowserForwardButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="BrowserRefreshButton" Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BrowserRefreshButton_Click" Margin="0,0,16,0" />
                                
                                <!-- Address Bar -->
                                <TextBox x:Name="BrowserAddressBar" Grid.Column="3" VerticalAlignment="Center" Height="40" Padding="12,0" Background="{DynamicResource InputBrush}" KeyDown="BrowserAddressBar_KeyDown" />
                                
                                <Button Grid.Column="4" Content="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource SecondaryButtonStyle}" Click="BrowserGoButton_Click" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                        
                        <!-- WebView2 Container -->
                        <Border x:Name="MarketplaceContainer" Grid.Row="1" />
                    </Grid>

                    <Grid Style="{StaticResource PageContainerStyle}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=About}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="About &amp; System" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="Application information and system diagnostics." Style="{StaticResource CaptionStyle}" Margin="0,0,0,24" />

                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Width="80" Height="80" CornerRadius="16" Background="{DynamicResource AccentBrush}" Margin="0,0,20,0">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Aura Engine Wallpaper" FontWeight="Bold" FontSize="24" Margin="0,0,0,4" />
                                            <TextBlock Text="Version 1.0.0-beta" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Created by " Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Text="Alazriel6" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Cursor="Hand" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="System Health" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16" />
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Processor" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PerformanceSnapshot.CpuText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Graphics" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PerformanceSnapshot.GpuText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Memory" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PerformanceSnapshot.RamText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="App Footprint" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PerformanceSnapshot.AppRamMb, StringFormat={}{0:0} MB}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Maintenance" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,12" />
                                        
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Clear Thumbnail Cache" FontWeight="SemiBold" />
                                                <TextBlock Text="Frees up disk space by deleting generated preview images." Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Clear Cache" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCacheCommand}" Width="120" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Force Garbage Collection" FontWeight="SemiBold" />
                                                <TextBlock Text="Immediately drops unreferenced objects from RAM." Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Trim Memory" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TrimMemoryCommand}" Width="120" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBrush}"
                    CornerRadius="0,0,24,24"
                    Padding="18,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding CurrentStatus}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentVideoName}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>

            <!-- PLAYLIST MODAL OVERLAY -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Background="#B2000000" Visibility="{Binding IsPlaylistMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="999">
                <!-- Click outside to cancel -->
                <Button Background="Transparent" BorderThickness="0" Command="{Binding CancelAddPlaylistCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Border Background="#0F172A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Width="400" MaxHeight="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.5" RenderingBias="Performance" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Select Playlist" Style="{StaticResource TitleTextStyle}" FontSize="18" Margin="24,24,24,16" />
                        
                        <!-- Playlist List -->
                        <ScrollViewer Grid.Row="1" Margin="12,0,12,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlaylistService.AllPlaylists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddToSpecificPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,0,0,8" HorizontalAlignment="Stretch" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultiParameterConverter}">
                                                    <Binding Path="DataContext.SelectedPreviewItem" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="" />
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#F8FAFC" />
                                                <TextBlock Grid.Column="2" Text="&#xE109;" FontFamily="Segoe UI, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="#94A3B8" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        
                        <!-- Footer -->
                        <Border Grid.Row="2" Margin="24,16,24,24" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" Padding="0,16,0,0">
                            <Button Content="Cancel" Command="{Binding CancelAddPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Width="100" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
