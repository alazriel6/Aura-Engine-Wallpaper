<Window x:Class="LiveWallpaperApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:LiveWallpaperApp.Helpers"
        xmlns:controls="clr-namespace:LiveWallpaperApp.Views.Controls"
        mc:Ignorable="d"
        Title="Live Wallpaper Studio"
        Width="1240"
        Height="780"
        MinWidth="1180"
        MinHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Icon="/Assets/AppIcon.png"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <helpers:PageVisibilityConverter x:Key="PageVisibilityConverter" />
        <helpers:StringMatchToBooleanConverter x:Key="StringMatchToBooleanConverter" />

        <!-- SLEEK SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="2" Width="4" HorizontalAlignment="Right" Background="#4DFFFFFF" Margin="0,2,2,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="2" Height="4" VerticalAlignment="Bottom" Background="#4DFFFFFF" Margin="2,0,2,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="MetricStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinHeight" Value="84" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            CornerRadius="24"
            Background="{DynamicResource WindowGlassBrush}"
            BorderBrush="{DynamicResource BorderGlowBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="{DynamicResource GlobalGlowRadius}"
                              ShadowDepth="0"
                              Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="9" Margin="0,0,12,0">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/AppIcon.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Live Wallpaper Studio" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="_" Style="{StaticResource WindowControlButtonStyle}" Click="OnMinimizeClick" />
                        <Button Content="[]" Style="{StaticResource WindowControlButtonStyle}" Click="OnMaximizeRestoreClick" />
                        <Button Content="X" Style="{StaticResource ChromeCloseButtonStyle}" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,4,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,12" />
                            <RadioButton Content="Home" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Dashboard}" Command="{Binding SelectPageCommand}" CommandParameter="Dashboard" />
                            <RadioButton Content="Playlist" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Playlist}" Command="{Binding SelectPageCommand}" CommandParameter="Playlist" />
                            <RadioButton Content="Settings" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Settings}" Command="{Binding SelectPageCommand}" CommandParameter="Settings" />
                            <RadioButton Content="Performance" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Performance}" Command="{Binding SelectPageCommand}" CommandParameter="Performance" />
                            <RadioButton Content="Advanced" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Advanced}" Command="{Binding SelectPageCommand}" CommandParameter="Advanced" />
                            <RadioButton Content="Monitors" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Monitors}" Command="{Binding SelectPageCommand}" CommandParameter="Monitors" />
                            <RadioButton Content="Themes" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Themes}" Command="{Binding SelectPageCommand}" CommandParameter="Themes" />
                            <RadioButton Content="Marketplace" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=Marketplace}" Command="{Binding SelectPageCommand}" CommandParameter="Marketplace" />
                            <RadioButton Content="About" Style="{StaticResource NavRadioButtonStyle}" IsChecked="{Binding SelectedPage, Converter={StaticResource StringMatchToBooleanConverter}, ConverterParameter=About}" Command="{Binding SelectPageCommand}" CommandParameter="About" />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom"
                                CornerRadius="16"
                                Padding="14"
                                Background="{DynamicResource SoftPanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RESOURCE MODE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SelectedPerformanceMode.Title}" Margin="0,6,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PerformanceSnapshot.AppRamMb, StringFormat={}{0:0} MB memory}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding AutoPauseState.Reason}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Dashboard}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE: LIBRARY GRID -->
                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <Grid Margin="18,18,18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSortMode}" />
                                    <Button Grid.Column="4" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Command="{Binding AddFolderCommand}" />
                                    <Button Grid.Column="6" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Command="{Binding RefreshLibraryCommand}" />
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredLibraryPreviews}"
                                         ItemContainerStyle="{StaticResource CardItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="18,0,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Margin="18,0,0,0" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="220"
                                                    Height="172"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource SoftPanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderGlowBrush}" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="114" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" CornerRadius="13,13,0,0" ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding PreviewPath, IsAsync=True}" Stretch="UniformToFill" 
                                                                   Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                            <Border Background="{DynamicResource InputBrush}"
                                                                    Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Path Fill="{DynamicResource MutedTextBrush}" Stretch="Uniform" Width="32" Height="32"
                                                                      Data="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z" />
                                                            </Border>
                                                            <MediaElement Source="{Binding PreviewPath}" LoadedBehavior="Pause" ScrubbingEnabled="True" Position="00:00:01" Stretch="UniformToFill" 
                                                                   Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="10"
                                                            Padding="9,4"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource AccentBrush}"
                                                            Visibility="{Binding IsActiveWallpaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="ACTIVE"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="10" />
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="14,10,14,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Use"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                MinWidth="60"
                                                                Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- RIGHT SIDE: PROPERTIES & PREVIEW -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <Border Height="180">
                                        <controls:LiveWallpaperPreviewControl VideoPath="{Binding VideoPath}"
                                                                              PlayerOptions="{Binding ThumbnailVlcOptions}"
                                                                              IsPreviewActive="{Binding IsDashboardActive}" />
                                    </Border>
                                    <StackPanel Margin="18">
                                        <TextBlock Text="Selected Wallpaper" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Preview and properties" Style="{StaticResource CaptionStyle}" />
                                        
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" MinWidth="80" Command="{Binding BrowseCommand}" />
                                        </Grid>
                                        
                                        <TextBlock Text="Display Monitor" Style="{StaticResource CaptionStyle}" Margin="0,16,0,8" />
                                        <ComboBox ItemsSource="{Binding MonitorSelections}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="DeviceName"
                                                  SelectedValue="{Binding SelectedMonitorDeviceName, Mode=TwoWay}" />
                                        
                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Apply Wallpaper" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Command="{Binding ApplyCommand}" />
                                            <Button Grid.Column="2" Content="Stop" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Command="{Binding StopCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quick Performance" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="Limit resources immediately." Style="{StaticResource CaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding SelectedPerformanceMode}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="Collapsed"></Grid>

                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Playlist}">
                        <ScrollViewer Padding="30,30,10,30">
                            <StackPanel MaxWidth="1050">
                                <!-- HEADER HUD -->
                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V7H17V17M15,15H9V9H15V15Z" Fill="#22d3ee" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"/>
                                            <TextBlock Text="SYSTEM_PLAYLIST" FontSize="28" FontWeight="Bold" Foreground="#22d3ee"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#22d3ee" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="STATUS: [AWAITING_INPUT]" Foreground="#22d3ee" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <TextBlock Text="MEM: OPTIMIZED" Foreground="#64748b" FontFamily="Consolas" FontSize="10" TextAlignment="Right"/>
                                        <TextBlock Foreground="#64748b" FontFamily="Consolas" FontSize="10" TextAlignment="Right">
                                            <Run Text="ITEMS_LOADED: "/>
                                            <Run Text="{Binding FilteredLibraryPreviews.Count, Mode=OneWay}" Foreground="#818cf8"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Line X1="0" Y1="0" X2="1050" Y2="0" Stroke="#22FFFFFF" StrokeThickness="1" Margin="0,0,0,20"/>

                                <!-- PLAYLIST GRID -->
                                <ItemsControl ItemsSource="{Binding FilteredLibraryPreviews}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Card -->
                                            <Border Margin="10" Width="310" Height="280" CornerRadius="12" Background="#111625" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveWallpaper}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#7006B6D4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="140" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- THUMBNAIL -->
                                                    <Border Grid.Row="0" Margin="12,12,12,0" CornerRadius="8" Background="#0A0A0A" BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
                                                        <Grid>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" Fill="#64748b" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                                                <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="NO_SIGNAL" Foreground="#64748b" FontFamily="Consolas" FontSize="10"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Image Source="{Binding PreviewPath, IsAsync=True}" Stretch="UniformToFill" Visibility="{Binding UsesSourceAsPreviewFallback, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- INFO -->
                                                    <StackPanel Grid.Row="1" Margin="12,14,12,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding IsActiveWallpaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#22d3ee" Width="8" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                                            <TextBlock Text="CURRENTLY_LOADED" Foreground="#22d3ee" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="#60000000" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                                                                <TextBlock Text="PATH" Foreground="#64748b" FontFamily="Consolas" FontSize="9"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding FilePath}" Foreground="#94a3b8" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <!-- ACTION BUTTON -->
                                                    <Border Grid.Row="2" Margin="12,0,12,12">
                                                        <Grid>
                                                            <Button Content="INITIALIZE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Cursor="Hand" Visibility="{Binding IsActiveWallpaper, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="#11FFFFFF"/>
                                                                        <Setter Property="Foreground" Value="#cbd5e1"/>
                                                                        <Setter Property="Padding" Value="0,10"/>
                                                                        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#22d3ee"/>
                                                                                <Setter Property="Foreground" Value="#67e8f9"/>
                                                                                <Setter Property="Background" Value="#1A0891B2"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            
                                                            <!-- ACTIVE BADGE -->
                                                            <Border Background="#1A06B6D4" BorderBrush="#4D06B6D4" BorderThickness="1" CornerRadius="6" Padding="0,10" Visibility="{Binding IsActiveWallpaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#22d3ee" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="ACTIVE" Foreground="#22d3ee" FontFamily="Consolas" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Settings}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="General" Style="{StaticResource TitleTextStyle}" />
                                        <CheckBox Content="Launch on startup" IsChecked="{Binding IsStartupEnabled}" />
                                        <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized}" />
                                        <CheckBox Content="Show tray icon" IsChecked="{Binding Settings.ShowTrayIcon}" />
                                        <CheckBox Content="Minimize to tray" IsChecked="{Binding Settings.MinimizeToTray}" />
                                        <CheckBox Content="Restore wallpaper automatically" IsChecked="{Binding Settings.AutoRestoreWallpaper}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Wallpaper" Style="{StaticResource TitleTextStyle}" />
                                        <CheckBox Content="Loop wallpaper" IsChecked="{Binding Settings.LoopWallpaper}" />
                                        <CheckBox Content="Auto shuffle" IsChecked="{Binding Settings.AutoShuffle}" />
                                        <CheckBox Content="Sync monitors" IsChecked="{Binding Settings.MultiMonitorSync}" />
                                        <TextBlock Text="{Binding Settings.PreviewQuality, StringFormat=Preview quality {0}%}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                        <Slider Minimum="10" Maximum="100" Value="{Binding Settings.PreviewQuality}" />
                                        <TextBlock Text="{Binding Settings.LiveThumbnailQuality, StringFormat=Live thumbnail quality {0}%}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                        <Slider Minimum="10" Maximum="100" Value="{Binding Settings.LiveThumbnailQuality}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Appearance" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Theme" Style="{StaticResource CaptionStyle}" />
                                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" />
                                        <TextBlock Text="Accent color" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Content="Apply" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyAccentCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Interface Feel" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="{Binding Settings.BlurStrength, StringFormat=Blur {0:0}}" Style="{StaticResource CaptionStyle}" />
                                        <Slider Minimum="0" Maximum="40" Value="{Binding Settings.BlurStrength}" />
                                        <TextBlock Text="{Binding Settings.GlowIntensity, StringFormat=Glow {0:P0}}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Settings.GlowIntensity}" />
                                        <TextBlock Text="{Binding Settings.AnimationSpeed, StringFormat=Animation speed {0:0.00}x}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                        <Slider Minimum="0.25" Maximum="2" Value="{Binding Settings.AnimationSpeed}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Performance}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Performance Mode" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Choose how much power the wallpaper should use." Style="{StaticResource CaptionStyle}" />
                                        <ComboBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding SelectedPerformanceMode}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Target FPS" Style="{StaticResource TitleTextStyle}" />
                                        <ComboBox ItemsSource="{Binding FpsModes}" SelectedItem="{Binding Settings.FpsLimit}" />
                                        <CheckBox Content="Auto performance mode" IsChecked="{Binding Settings.AutoPerformanceModeEnabled}" />
                                        <CheckBox Content="Reduce background usage" IsChecked="{Binding Settings.ReduceBackgroundUsageEnabled}" />
                                        <CheckBox Content="Memory saver" IsChecked="{Binding Settings.MemorySaverEnabled}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Smart Pause" Style="{StaticResource TitleTextStyle}" />
                                        <CheckBox Content="Pause while gaming" IsChecked="{Binding Settings.PauseFullscreenGame}" />
                                        <CheckBox Content="Pause on battery" IsChecked="{Binding Settings.PauseOnBattery}" />
                                        <CheckBox Content="Pause when PC is busy" IsChecked="{Binding Settings.PauseHighGpuUsage}" />
                                        <CheckBox Content="Pause when inactive" IsChecked="{Binding Settings.PauseUserInactive}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Live Monitor" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="{Binding PerformanceSnapshot.CpuText}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding PerformanceSnapshot.GpuText}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding PerformanceSnapshot.RamText}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding PerformanceSnapshot.VramText}" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Advanced}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Advanced Video" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="These options are for troubleshooting and high-end tuning." Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="Rendering backend" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                    <ComboBox ItemsSource="{Binding RenderEngines}" SelectedItem="{Binding Settings.RenderEngine}" />
                                    <TextBlock Text="Video performance" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                    <ComboBox ItemsSource="{Binding HardwareModes}" SelectedItem="{Binding Settings.HardwareAcceleration}" />
                                    <TextBlock Text="{Binding Settings.DecodeThreadCount, StringFormat=Decode helpers {0}}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                    <Slider Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.DecodeThreadCount}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Cache and Quality" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="{Binding Settings.ThumbnailCacheLimitMb, StringFormat=Preview cache {0} MB}" Style="{StaticResource CaptionStyle}" />
                                    <Slider Minimum="64" Maximum="2048" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding Settings.ThumbnailCacheLimitMb}" />
                                    <TextBlock Text="{Binding Settings.ThumbnailMaxConcurrentPlayers, StringFormat=Live previews at once {0}}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                    <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.ThumbnailMaxConcurrentPlayers}" />
                                    <TextBlock Text="{Binding Settings.RenderScale, StringFormat=Wallpaper quality {0:P0}}" Style="{StaticResource CaptionStyle}" Margin="0,14,0,8" />
                                    <Slider Minimum="0.5" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.RenderScale}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Monitors}">
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Monitors" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="Pilih target display tanpa membuat preview tambahan. Multi-monitor sync tetap dikontrol dari Settings." Style="{StaticResource CaptionStyle}" />
                                <ComboBox ItemsSource="{Binding MonitorSelections}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="DeviceName"
                                          SelectedValue="{Binding SelectedMonitorDeviceName, Mode=TwoWay}" />
                                <CheckBox Content="Sync monitors" IsChecked="{Binding Settings.MultiMonitorSync}" Margin="0,18,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Themes}">
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Themes" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="Tema dan accent color tetap ada, tapi efek glow/shadow default dibuat lebih ringan supaya RAM/GPU stabil." Style="{StaticResource CaptionStyle}" />
                                <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Apply" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyAccentCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=Marketplace}">
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Marketplace" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="Placeholder ringan untuk wallpaper pack / sharing nanti. Tidak ada WebView aktif supaya RAM tidak naik." Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=About}">
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="{Binding PerformanceSnapshot.AppRamMb, StringFormat=App memory: {0:0} MB}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding PerformanceSnapshot.CpuText}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding PerformanceSnapshot.GpuText}" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="Tip: hover card di Library untuk preview. Kalau tidak di-hover, video preview tidak decode." Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBrush}"
                    CornerRadius="0,0,24,24"
                    Padding="18,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding CurrentStatus}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentVideoName}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
